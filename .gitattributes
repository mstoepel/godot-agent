# Godot always writes its text formats with LF, and this project guarantees
# byte-for-byte round-tripping of them. A CRLF checkout would silently break
# that guarantee and turn every one-property scene edit into a whole-file diff.
*.tscn   text eol=lf
*.tres   text eol=lf
*.godot  text eol=lf
*.import text eol=lf
*.cfg    text eol=lf
*.gd     text eol=lf
*.uid    text eol=lf

# Keep the Python side consistent with CI, which runs on Linux.
*.py     text eol=lf
*.toml   text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf

uv.lock  text eol=lf linguist-generated=true
